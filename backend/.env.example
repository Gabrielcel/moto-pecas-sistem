# ===== Aplicação =====
NODE_ENV=development
PORT=3000
# URL pública do site (usada em links de acompanhamento e e-mails)
FRONTEND_URL=http://localhost:3000
# Origens permitidas por CORS (separe por vírgula). Vazio = mesma origem.
CORS_ORIGINS=
# Serve a pasta ../frontend pelo próprio backend (útil em dev / hospedagem única)
SERVE_FRONTEND=true

# ===== Banco de dados (PostgreSQL) =====
DATABASE_URL=postgres://postgres:postgres@localhost:5432/motopecas
DATABASE_SSL=false

# ===== Sessão e segurança =====
# true em produção (HTTPS)
COOKIE_SECURE=false
# lax (mesmo domínio) | none (frontend em outro domínio; exige COOKIE_SECURE=true)
COOKIE_SAMESITE=lax
SESSION_IDLE_HOURS=8
SESSION_ABSOLUTE_DAYS=7

# ===== Usuário administrador inicial (npm run seed) =====
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@motopecassistem.com.br
ADMIN_PASSWORD=Trocar@123456

# ===== Imagens =====
UPLOAD_DIR=./uploads

# ===== WhatsApp Business (API oficial / Cloud API da Meta) =====
# disabled | cloud_api
WHATSAPP_PROVIDER=disabled
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v20.0
# Número do responsável que recebe aviso de novo pedido (somente dígitos, com 55)
ADMIN_NOTIFY_PHONE=

# ===== E-mail (recuperação de senha) =====
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Moto Peças Sistem <no-reply@motopecassistem.com.br>"

# ===== Mapas / frete =====
# osrm | haversine
MAPS_PROVIDER=osrm
OSRM_URL=https://router.project-osrm.org
NOMINATIM_URL=https://nominatim.openstreetmap.org
MAPS_USER_AGENT=MotoPecasSistem/1.0 (contato@motopecassistem.com.br)

# ===== Backups =====
BACKUP_ENABLED=false
BACKUP_DIR=./backups
# Cópia em local separado do servidor principal (disco montado, rclone, etc.)
BACKUP_EXTERNAL_DIR=
# Comando opcional executado após cada backup. {file} = caminho do arquivo gerado
BACKUP_UPLOAD_COMMAND=
BACKUP_RETENTION_DAYS=14
BACKUP_HOUR=3

    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "multer": "^2.0.2",
    "nodemailer": "^6.9.14",
    "pg": "^8.12.0",
    "zod": "^3.23.8"
  },
  "optionalDependencies": {
    "sharp": "^0.33.4"
  }
}

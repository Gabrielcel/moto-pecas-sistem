{
  "name": "moto-pecas-sistem-backend",
  "version": "1.0.0",
  "description": "API da loja virtual Moto Peças Sistem",
  "main": "src/server.js",
  "private": true,
  "engines": { "node": ">=18" },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/database/migrate.js",
